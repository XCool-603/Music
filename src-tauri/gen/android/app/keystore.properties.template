# Android release signing — copy this file to "keystore.properties" and fill in real values.
# keystore.properties is git-ignored; never commit passwords or keystore files.
#
# storeFile: path to the .jks keystore.
#   - Absolute path, OR
#   - Relative path resolved against this directory (src-tauri/gen/android/app/).
#
# Generate a keystore (requires JDK / keytool on your machine or on macOS):
#   keytool -genkey -v -keystore muse-release.jks -alias muse -keyalg RSA \
#           -keysize 2048 -validity 10000 \
#           -storepass <STORE_PASSWORD> -keypass <KEY_PASSWORD> \
#           -dname "CN=muse-audio, OU=dev, O=muse, L=City, ST=State, C=CN"
#
# For Google Play / app store uploads you MUST use the SAME keystore for all
# subsequent releases. Keep a secure backup of it.

storeFile=muse-release.jks
storePassword=CHANGE_ME
keyAlias=muse
keyPassword=CHANGE_ME
