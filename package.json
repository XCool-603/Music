{
  "name": "muse-audio",
  "private": true,
  "version": "1.0.0",
  "description": "MUSE.AUDIO - 多端自适应Hi-Fi音乐播放器",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build:frontend": "vite build",
    "build:tauri": "node scripts/build-tauri-frontend.cjs",
    "build": "npm run build:frontend",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-tauri builds src-tauri/target",
    "lint": "tsc --noEmit",
    "icons": "node scripts/generate-icons.cjs && node scripts/generate-tauri-icons.cjs",
    "harmony:icons": "node scripts/generate-harmonyos-icons.cjs",
    "harmony:web": "npm run build:frontend && node scripts/deploy-harmonyos-web.cjs",
    "tauri": "tauri",
    "build:win": "npm run build:tauri && tauri build --target x86_64-pc-windows-msvc",
    "build:mac": "npm run build:tauri && tauri build --target universal-apple-darwin",
    "build:linux": "npm run build:tauri && tauri build --target x86_64-unknown-linux-gnu",
    "build:android": "npm run build:tauri && tauri android build",
    "build:ios": "npm run build:tauri && tauri ios build",
    "tauri:ios:init": "tauri ios init",
    "tauri:macos:init": "tauri macos init",
    "build:all": "node scripts/build-tauri.cjs",
    "tauri:dev": "tauri dev",
    "tauri:icon": "tauri icon src-tauri/icons/icon.png"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/screen-reader": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/crypto-js": "^4.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "canvas": "^3.2.3",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
